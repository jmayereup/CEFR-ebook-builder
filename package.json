{
  "name": "cefr-graded-books-generator",
  "private": true,
  "version": "0.0.8",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build --outDir dist/client && vite build --ssr src/entry-server.tsx --outDir dist/server && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "NODE_ENV=production node dist/server.cjs",
    "deploy": "./deploy.sh",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "typegen": "node -e \"require('dotenv').config(); const { spawnSync } = require('child_process'); spawnSync('npx', ['pocketbase-typegen', '--url', process.env.VITE_POCKETBASE_URL, '--email', process.env.POCKETBASE_ADMIN_EMAIL, '--password', process.env.POCKETBASE_ADMIN_PASSWORD, '--out', 'src/services/db/pocketbase-types.ts'], { stdio: 'inherit', shell: true });\"",
    "migrate:copyright-schema": "tsx migrate_copyright_schema.ts",
    "migrate:highlights-schema": "tsx migrate_highlights_schema.ts",
    "migrate:embed-schema": "tsx migrate_embed_story_schema.ts",
    "migrate:story-indexes": "tsx migrate_story_indexes.ts",
    "flag-copyright:dry": "tsx migrate_copyright_flags.ts --dry",
    "flag-copyright": "tsx migrate_copyright_flags.ts",
    "generate-covers": "tsx scripts/generate-covers.ts",
    "generate-covers:test": "tsx scripts/generate-covers.ts --test",
    "check-covers": "tsx scripts/check-and-reupload-covers.ts",
    "reupload-covers": "tsx scripts/check-and-reupload-covers.ts --reupload",
    "biome:format": "biome format --write .",
    "biome:lint": "biome lint .",
    "biome:check": "biome check --write ."
  },
  "dependencies": {
    "@openrouter/sdk": "^0.12.79",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "idb-keyval": "^6.3.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.43.0",
    "pocketbase": "^0.27.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sharp": "^0.35.1",
    "vite": "^6.2.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@types/express": "^4.17.21",
    "@types/jszip": "^3.4.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.1",
    "pocketbase-typegen": "^1.5.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.12",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vite-plugin-pwa": "^1.3.0"
  },
  "overrides": {
    "esbuild": "$esbuild"
  },
  "allowScripts": {
    "@openrouter/sdk@0.12.79": true,
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.1": true
  }
}
