VITE_BACKEND_PROVIDER=pocketbase
VITE_POCKETBASE_URL=your_url_without_api_ending_here

# PocketBase Admin credentials (used for schema setup, migrations, and typegen)
POCKETBASE_ADMIN_EMAIL=your_pocketbase_admin_email_here
POCKETBASE_ADMIN_PASSWORD=your_pocketbase_admin_password_here

# PocketBase regular user with isAdmin=true (used for server runtime operations to prevent superuser login notification emails)
POCKETBASE_EMAIL=your_pocketbase_user_email_here
POCKETBASE_PASSWORD=your_pocketbase_user_password_here

# Deployment configuration
DEPLOY_SERVER_IP=your_server_ip_here
DEPLOY_SERVER_USER=your_server_user_here
DEPLOY_SERVER_PATH=your_server_path_here
DEPLOY_SERVICE_NAME=your_service_name_here

# Optional: The public URL of the application server where covers are served.
# Falls back to VITE_POCKETBASE_URL if not specified.
APP_URL=https://your-app-domain.com

# Optional: Model used for copyright/IP-risk classification of stories
# (outline-time flags, scratch-mode checks, and the backfill script).
# Defaults to google/gemini-2.5-flash. Choose a cheap, fast model.
IP_CLASSIFIER_MODEL=google/gemini-2.5-flash

# AI Generation Microservice URL (tj-gen)
TJ_GEN_URL=https://gen.teacherjake.com

# Optional: Direct CDN/CloudFront base URL for story covers (bypasses the
# PocketBase /api/files/ proxy). Requires VITE_POCKETBASE_URL's S3 storage to
# be enabled in PocketBase. Path layout matches PocketBase's S3 keys:
#   ${VITE_COVER_CDN_URL}/${collectionId}/${storyId}/${coverFilename}
# Leave blank to serve covers via the PocketBase proxy as before.
# VITE_COVER_CDN_URL=https://cdn.teacherjake.com

