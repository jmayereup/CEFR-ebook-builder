OPENROUTER_API_KEY=your_openrouter_api_key_here
VITE_BACKEND_PROVIDER=pocketbase
VITE_POCKETBASE_URL=your_url_without_api_ending_here

# PocketBase Admin credentials (used for schema typegen and server-side operations)
POCKETBASE_ADMIN_EMAIL=your_pocketbase_admin_email_here
POCKETBASE_ADMIN_PASSWORD=your_pocketbase_admin_password_here

# Deployment configuration
DEPLOY_SERVER_IP=your_server_ip_here
DEPLOY_SERVER_USER=your_server_user_here
DEPLOY_SERVER_PATH=your_server_path_here
DEPLOY_SERVICE_NAME=your_service_name_here

# Optional: The public URL of the application server where covers are served.
# Falls back to VITE_POCKETBASE_URL if not specified.
APP_URL=https://your-app-domain.com

# Optional: Model used for copyright/IP-risk classification of stories
# (outline-time flags, scratch-mode checks, and the backfill script).
# Defaults to google/gemini-3.6-flash. Choose a cheap, fast model.
IP_CLASSIFIER_MODEL=google/gemini-3.1-flash-lite
